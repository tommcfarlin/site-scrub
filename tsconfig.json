{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "module": "ES2022",
    "target": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome", "node"],
    "skipLibCheck": true
  },
  "include": ["*.js", "test/**/*.js", "scripts/**/*.js", "e2e/**/*.js"]
}
